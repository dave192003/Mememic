{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MemeMic",
            "type": "shell",
            "command": "npm.cmd run dev",
            "options": {
                "cwd": "${workspaceFolder}/MemeMic"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start MemeMic",
            "dependsOn": [
                "MemeMic"
            ],
            "dependsOrder": "parallel",
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
